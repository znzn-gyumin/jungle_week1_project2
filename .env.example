# Spotify Developer Dashboard 에서 앱 생성 후 발급
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Dashboard 의 "Redirect URIs" 에 아래 값을 그대로 등록해야 함.
# Spotify 는 http://localhost 를 거부함. 반드시 127.0.0.1 사용.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# 로그인 완료 후 돌아갈 프론트엔드 주소 (Vite dev server)
CLIENT_ORIGIN=http://127.0.0.1:5173

SERVER_PORT=8000
