YOUTUBE_API_KEY=
ITUNES_COUNTRY=KR

SSL_TRUST_SYSTEM=false

CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SERVER_PORT=8000
SERVER_HOST=127.0.0.1
SERVER_RELOAD=true

# 도커로 API 를 띄울 때 호스트에 공개할 포트. SERVER_HOST/SERVER_PORT 는
# docker-compose.yml 이 컨테이너용 값(0.0.0.0:8000)으로 덮어쓰므로 건드릴 필요 없다.
API_PORT=8000

# HTTPS 로 서비스하면 true. 세션 쿠키에 Secure 플래그가 붙는다.
COOKIE_SECURE=false

# Shared dev DB (TLS required). Ask the team for the password.
# Leave HOST=localhost to run a throwaway local postgres via `npm run db` instead.
# 도커로 띄우면 localhost 는 compose 의 postgres 서비스로 자동 치환된다
# (backend/docker-entrypoint.sh). 원격 호스트면 그대로 원격에 붙고 마이그레이션도 건너뛴다.
POSTGRES_HOST=64.110.116.62
POSTGRES_PORT=55432
POSTGRES_USER=jungle
POSTGRES_PASSWORD=
POSTGRES_DB=flowbee
